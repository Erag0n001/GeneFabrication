<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputPath>..\..\1.7\Assemblies</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
		<DebugType>embedded</DebugType>
		<LangVersion>latest</LangVersion>
		<AssemblyName>GeneFabrication</AssemblyName>
		<RootNamespace>GeneFabrication</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE;</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" />
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" />
	</ItemGroup>
	<ItemGroup>
		<AdditionalFiles
				Include="..\..\1.7\Defs\**\*.xml"
				Link="Defs\%(RecursiveDir)%(Filename)%(Extension)" />
		<AdditionalFiles
				Include="..\..\Languages\**\*.xml"
				Link="Languages\%(RecursiveDir)%(Filename)%(Extension)" />
		<AdditionalFiles
				Include="..\..\About\**\*.*"
				Link="About\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
