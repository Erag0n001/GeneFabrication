<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BenchBase">
    <defName>GeneFab_GeneBench</defName>
    <label>gene fabrication bench</label>
    <description>A biotech workbench equipped with advanced tools capable of creating genes from neutroamine.</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(5,2)</size>
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <graphicData>
      <texPath>Things/Building/Production/GeneBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(7,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2530</uiOrder>
    <surfaceType>Item</surfaceType>
    <designationHotKey>Misc12</designationHotKey>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>GeneFabrication</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BenchBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>GeneFab_CompactGeneBench</defName>
    <label>compact gene fabrication bench</label>
    <description>A space-efficient, gravship-powered biotech workbench designed for use aboard gravships. Despite its smaller frame, it is equipped with advanced tools capable of creating genes from neutroamine. It draws power directly from the grav engine.</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <statBases>
		<MaxHitPoints>200</MaxHitPoints>
		<WorkToBuild>6000</WorkToBuild>
		<Flammability>1</Flammability>
    </statBases>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(3,1)</size>
    <costList>
		<Steel>100</Steel>
		<ComponentIndustrial>15</ComponentIndustrial>
		<ComponentSpacer>5</ComponentSpacer>
    </costList>
    <comps>
		<li Class="CompProperties_Power">
			<compClass>CompPowerTrader</compClass>
			<basePowerConsumption>400</basePowerConsumption>
			<shortCircuitInRain>true</shortCircuitInRain>
		</li>
		<li Class="CompProperties_Flickable"/>
		<li Class="CompProperties_Breakdownable"/>
    </comps>
    <graphicData>
		<texPath>Things/Building/Production/CompactGeneBench</texPath>
		<graphicClass>Graphic_Multi</graphicClass>
		<shaderType>CutoutComplex</shaderType>
		<drawSize>(6,2)</drawSize>
		<damageData>
			<cornerTL>Damage/Corner</cornerTL>
			<cornerTR>Damage/Corner</cornerTR>
			<cornerBL>Damage/Corner</cornerBL>
			<cornerBR>Damage/Corner</cornerBR>
		</damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
		<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
		<relatedTerrain>
			<li>Substructure</li>
		</relatedTerrain>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2530</uiOrder>
    <surfaceType>Item</surfaceType>
    <designationHotKey>Misc12</designationHotKey>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <placeWorkers>
		<li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
		<li>GeneFabrication</li>
		<li MayRequire="vanillaexpanded.gravship">VGE_CompactWorkspaces</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>